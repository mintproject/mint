{
  "name": "ui-react",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "config:local": "sh scripts/config-local.sh",
    "build": "tsc -b && vite build && node scripts/generate-env-config.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "codegen": "graphql-codegen --config codegen.ts",
    "typecheck": "tsc -b",
    "prepare": "cd .. && husky ui-react/.husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,css,json}": "prettier --write"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@react-google-maps/api": "^2.20.8",
    "@tanstack/react-table": "^8.20.0",
    "@types/leaflet": "^1.9.21",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.0.0",
    "elkjs": "0.12.0",
    "graphql": "^16.9.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.400.0",
    "match-sorter": "^6.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-md5": "^1.3.1",
    "uuid": "^14.0.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/schema-ast": "^6.1.0",
    "@graphql-codegen/typescript": "^4.0.9",
    "@graphql-codegen/typescript-operations": "^4.2.3",
    "@graphql-codegen/typescript-react-apollo": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/google.maps": "^3.65.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.7.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.8",
    "globals": "^15.8.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.0",
    "lint-staged": "^17.0.7",
    "msw": "^2.14.6",
    "postcss": "^8.4.39",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "tailwindcss": "^3.4.6",
    "typescript": "~5.5.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
