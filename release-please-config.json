{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "exclude-paths": ["charts/mint"],
      "extra-files": [
        { "type": "json", "path": "model-catalog-api/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "mint-ensemble-manager/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "ui-react/package.json", "jsonpath": "$.version" }
      ]
    },
    "charts/mint": {
      "release-type": "helm",
      "include-component-in-tag": false,
      "include-v-in-tag": false,
      "include-v-in-release-name": false
    }
  }
}
